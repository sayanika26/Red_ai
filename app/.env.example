# Local Ollama defaults; replace these for another OpenAI-compatible provider.
PRITHI_LLM_BASE_URL=http://127.0.0.1:11434/v1
PRITHI_LLM_API_KEY=ollama
PRITHI_LLM_MODEL=gemma3:12b
PRITHI_LLM_NORMAL_MODEL=gemma3:12b
PRITHI_LLM_ADULT_MODEL=richardyoung/qwen3-14b-abliterated:Q4_K_M
PRITHI_DEFAULT_STT_LANGUAGE=bengali
PRITHI_WEB_ACCESS_TOKEN=
PRITHI_WEB_PORT=8000
PRITHI_VOICE_REPLY_MODE=concise
PRITHI_LLM_MAX_TOKENS=192
PRITHI_LLM_STREAMING=false
PRITHI_OLLAMA_KEEP_ALIVE=10m
PRITHI_VOICE_PACE_PROFILE=brisk
PRITHI_STT_DIAGNOSTICS=false
PRITHI_STT_BENGALI_PRIMARY=large-v3
PRITHI_STT_BENGALI_PROMPT=false
PRITHI_STT_BEAM_SIZE=5
PRITHI_STT_BENGALI_VAD=true
PRITHI_VOICE_EMOTION_PACES_JSON=

# Set this locally to your service-account JSON path. Never commit the JSON.
GOOGLE_APPLICATION_CREDENTIALS=
